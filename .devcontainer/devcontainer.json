{
  "name": "Website",
  "dockerComposeFile": "../compose.local.yml",
  "service": "website",
  "workspaceFolder": "/srv/site",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "sissel.shopify-liquid"],
      "settings": {
        "editor.formatOnSave": false
      }
    }
  },
  "initializeCommand": "npm ci && npm run build:js"
}
