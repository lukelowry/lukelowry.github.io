{% assign image_path = include.url | default: include.path %}
{% assign image_alt = include.alt | default: include.caption | default: include.title | default: '' | strip_html %}
{% assign image_parts = image_path | split: '.' %}
{% assign image_ext = image_parts.last | downcase %}
{% assign image_stem = image_parts | pop | join: '.' %}
{% assign image_formats = 'jpg,jpeg,png,tiff,gif' | split: ',' %}
{% assign responsive = false %}
{% if site.imagemagick.enabled and image_path contains 'assets/img/' and image_formats contains image_ext %}
  {% unless include.avoid_scaling or image_path contains '://' %}{% assign responsive = true %}{% endunless %}
{% endif %}
{% assign image_version = null %}
{% if include.cache_bust %}
  {% assign image_version = image_path | bust_file_cache | split: '?' | last %}
{% endif %}
<figure
  {% if include.slot %}
    slot="{{ include.slot | escape }}"
  {% endif %}
>
  <picture>
    {% if responsive %}
      <source
        type="image/webp"
        srcset="{% for width in site.imagemagick.widths %}{{ image_stem | relative_url }}-{{ width }}.webp{% if image_version %}?{{ image_version }}{% endif %} {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
        sizes="{{ include.sizes | default: '95vw' | escape }}"
      >
    {% endif %}
    <img
      src="{% if include.cache_bust %}{{ image_path | relative_url | bust_file_cache | escape }}{% else %}{{ image_path | relative_url | escape }}{% endif %}"
      alt="{% if include.alt != nil %}{{ include.alt | escape }}{% else %}{{ image_alt | escape }}{% endif %}"
      {% if include.class %}
        class="{{ include.class | escape }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width | escape }}"
      {% endif %}
      {% if include.height %}
        height="{{ include.height | escape }}"
      {% endif %}
      {% if include.title %}
        title="{{ include.title | escape }}"
      {% endif %}
      {% if include.zoomable %}
        data-zoomable
      {% endif %}
      {% if include.loading %}
        loading="{{ include.loading | escape }}"
      {% elsif site.lazy_loading_images %}
        loading="lazy"
      {% endif %}
      decoding="async"
      {% if responsive %}
        onerror="this.onerror=null; this.parentElement.querySelectorAll('source').forEach(source => source.remove());"
      {% endif %}
    >
  </picture>
  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
