{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.impressum_path | relative_url | escape }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}sticky-bottom mt-5{% endif %}">
  <div class="container">
    <div class="footer-copy">{{ footer_contents }}</div>
  </div>
</footer>

{% if site.back_to_top %}
  <button id="back-to-top" type="button" aria-controls="main-content" hidden>Back to top</button>
{% endif %}
