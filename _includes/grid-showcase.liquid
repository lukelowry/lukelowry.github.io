<section
  id="usa-network"
  class="grid-wave"
  aria-label="USA power network"
  data-grid-wave
  data-assets="{{ '/assets/grids/' | relative_url }}"
  data-runtime="{{ '/assets/generated/latkit.js' | relative_url | bust_file_cache }}"
>
  {% include grid-still.liquid asset="USA" alt="USA power network: buses and transmission lines" %}
  <div class="grid-wave-stage">
    <latkit-network
      aria-label="USA power network"
      projection="flat"
      wheel="modifier"
      keyboard
      daylight="false"
      earth-axis="false"
      borders="false"
      poles="false"
      motion="auto"
    >
      <picture>
        <source
          media="(max-width: 767px), (hover: none) and (pointer: coarse)"
          srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        >
        <img
          class="grid-poster grid-poster-light"
          src="{{ '/assets/grids/USA-light.webp' | relative_url }}"
          alt="USA power network: buses and transmission lines"
          width="1600"
          height="820"
          loading="lazy"
          decoding="async"
        >
      </picture>
      <picture>
        <source
          media="(max-width: 767px), (hover: none) and (pointer: coarse)"
          srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        >
        <img
          class="grid-poster grid-poster-dark"
          src="{{ '/assets/grids/USA-dark.webp' | relative_url }}"
          alt="USA power network: buses and transmission lines"
          width="1600"
          height="820"
          loading="lazy"
          decoding="async"
        >
      </picture>
    </latkit-network>
    <span class="grid-inspection" aria-hidden="true" hidden></span>
  </div>
  <div class="grid-wave-controls">
    <button type="button" data-action="play" disabled>Pause</button>
    <button type="button" data-action="zoom-in" disabled>Zoom in</button>
    <button type="button" data-action="zoom-out" disabled>Zoom out</button>
    <button type="button" data-action="reset" disabled>Reset view</button>
    <button type="button" data-action="fullscreen" hidden>Fullscreen</button>
    <form class="grid-bus-picker">
      <label for="grid-bus-number">Bus number</label>
      <input
        id="grid-bus-number"
        name="bus"
        type="text"
        inputmode="numeric"
        pattern="[0-9]+"
        required
        autocomplete="off"
        size="8"
        aria-describedby="grid-status"
        disabled
      >
      <button type="submit" disabled>Select bus</button>
    </form>
  </div>
  <p class="grid-keyboard-help" hidden>Arrow keys: pan. + / &minus;: zoom. Home: reset view. Escape: clear selection.</p>
  <p id="grid-status" class="grid-status" role="status" aria-live="polite" aria-atomic="true">Static view.</p>
  <a class="grid-data-link" href="{{ '/assets/grids/USA.json' | relative_url }}" download>Grid data (JSON)</a>
</section>
<script type="module" src="{{ '/assets/js/grids/index.mjs' | relative_url | bust_file_cache }}"></script>
