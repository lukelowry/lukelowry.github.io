{% include metadata.liquid %}
<link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">
<link rel="stylesheet" href="{{ site.third_party_libraries.google_fonts.url.fonts }}">
<link rel="icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache }}">
{% if page.toc and page.toc.sidebar %}
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap-toc.min.css' | relative_url | bust_file_cache }}">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
<link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url | bust_file_cache }}">
{% if page.grid_backdrops or page.grid_showcase %}
  <link rel="stylesheet" href="{{ '/assets/css/grids.css' | relative_url | bust_file_cache }}">
{% endif %}
{% if page.code %}
  <link rel="stylesheet" href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}" id="highlight_theme_light">
  <link
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="not all"
    id="highlight_theme_dark"
  >
{% endif %}
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
{% if site.data.hreflangs %}
  {% for entry in site.data.hreflangs %}
    <link rel="alternate" href="{{ entry.url | absolute_url }}" hreflang="{{ entry.lang | escape }}">
  {% endfor %}
{% endif %}
{% if site.enable_darkmode %}
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <script>
    initTheme();
  </script>
{% endif %}
<noscript>
  <style>
    #navbarNav {
      display: flex !important;
    }
    #navbar {
      position: static;
    }
    body.fixed-top-nav {
      padding-top: 0;
    }
    #navbarNav .navbar-nav {
      flex-direction: row;
      flex-wrap: wrap !important;
      gap: 0.25rem;
    }
    [data-grid-still],
    .navbar-toggler,
    .accessibility,
    [data-bib-toggle] {
      display: none !important;
    }
    .publications .hidden[hidden] {
      display: block !important;
      max-height: none !important;
      overflow: visible !important;
      opacity: 1 !important;
    }
  </style>
</noscript>
