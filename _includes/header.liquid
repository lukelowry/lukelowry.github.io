<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Main">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ "/" | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% assign home_page = site.pages | where: 'url', '/' | first %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
            >
              {{- home_page.title | escape }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown-{{ forloop.index }}"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown-{{ forloop.index }}">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a
                    class="nav-link"
                    href="{{ url | relative_url }}"
                    {% if page.url == p.url %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="accessibility" hidden>
      <button
        id="accessibility-toggle"
        type="button"
        aria-label="Accessibility and appearance"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="accessibility-panel"
        title="Accessibility and appearance"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="7" r="1.25" fill="currentColor" stroke="none"></circle>
          <path d="M6.5 10l5.5 1 5.5-1M12 11v3m0 0-3 4m3-4 3 4"></path>
        </svg>
      </button>
      <div id="accessibility-panel" role="dialog" aria-labelledby="accessibility-title" hidden>
        <h2 id="accessibility-title" data-toc-skip>Accessibility &amp; appearance</h2>
        <fieldset>
          <legend>Theme</legend>
          <div class="appearance-options">
            <label><input type="radio" name="theme" value="system"><span>System</span></label>
            <label><input type="radio" name="theme" value="light"><span>Light</span></label>
            <label><input type="radio" name="theme" value="dark"><span>Dark</span></label>
          </div>
        </fieldset>
        <fieldset aria-describedby="animation-description">
          <legend>Animation</legend>
          <div class="appearance-options">
            <label><input type="radio" name="animation" value="full"><span>Full</span></label>
            <label><input type="radio" name="animation" value="reduced"><span>Reduced</span></label>
            <label><input type="radio" name="animation" value="off"><span>Off</span></label>
          </div>
          <p id="animation-description"></p>
        </fieldset>
        <fieldset>
          <legend>Contrast</legend>
          <div class="appearance-options">
            <label><input type="radio" name="contrast" value="standard"><span>Standard</span></label>
            <label><input type="radio" name="contrast" value="high"><span>High</span></label>
          </div>
        </fieldset>
        <fieldset data-network-effect-options>
          <legend>Network effect</legend>
          <div class="appearance-options">
            <label><input type="radio" name="network-effect" value="spring"><span>Spring</span></label>
            <label><input type="radio" name="network-effect" value="electric"><span>Electric</span></label>
          </div>
        </fieldset>
      </div>
    </div>
  </nav>
</header>
