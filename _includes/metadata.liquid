{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

{% assign meta_description = page.description | default: site.description | strip_html | normalize_whitespace %}
{% assign meta_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign meta_image = page.og_image | default: page.img | default: site.og_image %}
{% assign meta_image_key = meta_image | replace: '/assets/', 'assets/' %}
{% assign meta_image = site.asset_aliases[meta_image_key] | default: meta_image %}
{% if page.og_image or page.img %}
  {% assign meta_image_alt = page.og_image_alt | default: page.img_alt | default: page.title %}
{% else %}
  {% assign meta_image_alt = site.og_image_alt | default: site.title %}
{% endif %}

<!-- Standard metadata -->
<meta charset="utf-8">
{% if site.noindex or page.noindex %}
  <meta name="robots" content="noindex, follow">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
{% capture title %}{% if site.title == 'blank' %}{{ author_name }}{% else %}{{ site.title }}{% endif %}{% endcapture %}
{% capture seo_title %}{% if page.url == '/' or page.title == blank or page.title == 'blank' %}{{ title }}{% else %}{{ page.title }} | {{ title }}{% endif %}{% endcapture %}
<title>{{ seo_title | strip | escape }}</title>
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ meta_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords | escape }}{% else %}{{ site.keywords | escape }}{% endif %}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.collection == 'posts' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ title | strip | escape }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ seo_title | strip | escape }}">
  <meta property="og:url" content="{{ meta_url | escape }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  {% if meta_image != blank %}
    <meta property="og:image" content="{{ meta_image | absolute_url | escape }}">
    <meta property="og:image:alt" content="{{ meta_image_alt | escape }}">
  {% endif %}
  <meta property="og:locale" content="{{ site.og_locale | default: 'en_US' }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ seo_title | strip | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  {% if meta_image != blank %}
    <meta name="twitter:image" content="{{ meta_image | absolute_url | escape }}">
    <meta name="twitter:image:alt" content="{{ meta_image_alt | escape }}">
  {% endif %}
  {% if site.data.socials.x_username %}
    <meta name="twitter:site" content="@{{ site.data.socials.x_username }}">
    <meta name="twitter:creator" content="@{{ site.data.socials.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% assign sameaslinks = '' | split: ',' %}
  {% for social in site.data.socials %}
    {% assign link_format = site.data.social_links[social[0]] %}
    {% assign profile_link = null %}
    {% if link_format %}
      {% assign profile_link = link_format | replace: '{value}', social[1] %}
    {% elsif social[1].url %}
      {% assign profile_link = social[1].url %}
    {% endif %}
    {% if profile_link != blank %}
      {% assign sameaslinks = sameaslinks | push: profile_link %}
    {% endif %}
  {% endfor %}
  {% assign sameaslinks = sameaslinks | uniq %}

  {% assign schema_url = meta_url %}
  {% assign schema_description = meta_description %}
  {% assign schema_title = seo_title | strip %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{% if page.url == '/' %}ProfilePage{% elsif is_blog_post %}BlogPosting{% else %}WebPage{% endif %}",
      "url": {{ schema_url | jsonify }},
      "name": {{ schema_title | jsonify }},
      "description": {{ schema_description | jsonify }},
      "{% if page.url == '/' %}mainEntity{% else %}author{% endif %}": {
        "@type": "Person",
        "@id": {{ '/#person' | absolute_url | jsonify }},
        "name": {{ author_name | strip | jsonify }},
        "url": {{ '/' | absolute_url | jsonify }}{% if sameaslinks != blank %},
        "sameAs": {{ sameaslinks | jsonify }}{% endif %}
      }
    }
  </script>
{% endif %}
