{% assign sorted_projects = include.projects | sort: 'importance' %}
<div class="projects">
  {% if site.enable_project_categories and include.categories %}
    <nav class="collection-toolbar project-navigation" aria-label="Project categories">
      <div class="project-category-links">
        {% for category in include.categories %}
          {% assign category_projects = sorted_projects | where: 'category', category %}
          {% if category_projects.size > 0 %}
            <a href="#{{ category | slugify }}">
              {%- if category == 'work' %}Research software{% else %}{{ category | capitalize | escape }}{% endif -%}
            </a>
          {% endif %}
        {% endfor %}
      </div>
      {% assign visible_project_count = 0 %}
      {% for category in include.categories %}
        {% assign category_count = sorted_projects | where: 'category', category | size %}
        {% assign visible_project_count = visible_project_count | plus: category_count %}
      {% endfor %}
      <span class="collection-count">{{ visible_project_count }} projects</span>
    </nav>
    {% for category in include.categories %}
      {% assign category_projects = sorted_projects | where: 'category', category %}
      {% if category_projects.size > 0 %}
        <section aria-labelledby="{{ category | slugify }}">
          <h2 class="category" id="{{ category | slugify }}">
            {% if category == 'work' %}Research software{% else %}{{ category | capitalize | escape }}{% endif %}
          </h2>
          {% include project-grid.liquid projects=category_projects horizontal=include.horizontal %}
        </section>
      {% endif %}
    {% endfor %}
  {% else %}
    {% include project-grid.liquid projects=sorted_projects horizontal=include.horizontal %}
  {% endif %}
</div>
