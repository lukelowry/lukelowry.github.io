<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign presentations = include.content | sort: 'date' | reverse %}
  {% for content in presentations %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% assign date = content.date | split: '-' | join: '.' %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          {% include resume/title.liquid text=content.position url=content.url %}
          <p class="cv-detail">{{ content.name }}</p>
          {% if content.summary and content.summary != '' %}
            <p class="cv-detail cv-detail-emphasis">{{ content.summary }}</p>
          {% endif %}
          {% if content.highlights.size > 0 %}
            <ul class="items">
              {% for item in content.highlights %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
