---
layout: default
---
<div class="post home-page">
  <div class="home-intro">
    <header class="post-header">
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name | escape }}</span> {{ site.middle_name | escape }}
          {{ site.last_name | escape }}
        {% else %}
          {{ site.title | escape }}
        {% endif %}
      </h1>
      {% if page.subtitle %}
        <p class="desc">{{ page.subtitle }}</p>
      {% endif %}
    </header>
    {% if page.profile %}
      <div class="profile">
        {% if page.profile.image %}
          {% assign profile_image = page.profile.image | prepend: 'assets/img/' %}
          {% capture profile_alt %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
          {% include figure.liquid path=profile_image alt=profile_alt class="img-fluid rounded" sizes="(max-width: 575px) 94px, 104px" loading="eager" cache_bust=true %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
  <article>
    <div class="home-research">{{ content }}</div>
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        {% if site.contact_note %}
          <div class="contact-note">{{ site.contact_note }}</div>
        {% endif %}
      </div>
    {% endif %}
  </article>
</div>
