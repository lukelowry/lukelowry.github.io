---
layout: default
---
{% assign cv_pdf = site.cv_download | default: page.cv_pdf %}
{% unless site.data.resume %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if cv_pdf %}
          <a
            {% if cv_pdf contains '://' %}
              href="{{ cv_pdf }}"
            {% else %}
              href="{{ cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
            aria-label="Download PDF"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for entry in site.data.cv %}
          <a class="anchor" id="{{ entry.title }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
            <div>
              {% if entry.type == 'list' %}
                {% include cv/list.liquid %}
              {% elsif entry.type == 'map' %}
                {% include cv/map.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% elsif entry.type == 'list_groups' %}
                {% include cv/list_groups.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if cv_pdf %}
          <a
            {% if cv_pdf contains '://' %}
              href="{{ cv_pdf }}"
            {% else %}
              href="{{ cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
            aria-label="Download PDF"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for section in site.jsonresume %}
          {% assign section_data = site.data.resume[section] %}
          {% unless section == 'publications' %}
            {% if section == 'meta' or section_data == null or section_data.size == 0 %}{% continue %}{% endif %}
          {% endunless %}
          <a class="anchor" id="{{ section }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ section | capitalize }}</h3>
            <div>
              {% case section %}
                {% when 'basics' %}
                  {% include resume/basics.liquid content=section_data %}
                {% when 'education' %}
                  {% include resume/education.liquid content=section_data %}
                {% when 'work' %}
                  {% include resume/work.liquid content=section_data %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid content=section_data %}
                {% when 'leadership' %}
                  {% include resume/leadership.liquid content=section_data %}
                {% when 'presentations' %}
                  {% include resume/presentations.liquid content=section_data %}
                {% when 'projects' %}
                  {% include resume/projects.liquid content=section_data %}
                {% when 'awards' %}
                  {% include resume/awards.liquid content=section_data %}
                {% when 'skills' %}
                  {% include resume/skills.liquid content=section_data %}
                {% when 'publications' %}
                  {% include resume/publications.liquid content=section_data %}
                {% when 'languages' %}
                  {% include resume/languages.liquid content=section_data %}
                {% when 'interests' %}
                  {% include resume/interests.liquid content=section_data %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid content=section_data %}
                {% when 'references' %}
                  {% include resume/references.liquid content=section_data %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}
